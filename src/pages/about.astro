---
import cx from 'classnames';
import { MdKeyboardDoubleArrowLeft } from 'react-icons/md';

import Layout from '../layouts/Layout.astro';
import BannerGraphic from '../components/BannerGraphic.astro';
---

<Layout subtitle="About">
	<section class="wrapper relative h-full w-full overflow-hidden">
		<BannerGraphic />
		<div class="flex flex-col md:h-full">
			<div class="flex flex-col w-full mx-auto">
				<div class="m-6 md:m-10 z-10">
					<div
						id="about-container"
						class={cx(
							'about-container',
							'flex flex-col max-w-4xl',
							'py-20 lg:py-10',
							'opacity-0 transition-all duration-100 ease-in-expo delay-200'
						)}
					>
						<img src="/me3.jpg" class="max-w-140 rounded-2xl mb-10" />
						<p class="font-bold mb-4 text-lg md:text-2xl">
							Hi! <br /> My name is Pierre Sköldborg. I'm a freelance web developer
							from Sweden living in Gothenburg.
						</p>

						<p class="mb-4 md:text-lg">
							I work across the full JavaScript stack and have a particular
							fondness for React, Node.js, and accessibility. With over ten
							years of experience, I've worked on both large-scale, complex
							projects involving many stakeholders and in small startup teams.
						</p>

						<p class="mb-4 md:text-lg">
							Beyond the pure programming aspect of my work, I am passionate
							about knowledge sharing and mentoring. Among my various
							activities, I have taught courses in NodeJS, MongoDB, and GraphQL
							at <a
								href="https://www.yrgo.se/"
								target="_blank"
								rel="noopener noreferrer">Yrgo</a
							>.
						</p>

						<p class="mb-4 md:text-lg">
							I am a highly motivated, sociable, and well-organized developer
							and my focus is always on delivering solutions that are intuitive
							and accessible to the end user as well as robust and easy to
							understand for my fellow developers.
						</p>

						<a
							id="link-back"
							href="/"
							class="flex underline items-center gap-2 md:text-lg mt-4"
						>
							<MdKeyboardDoubleArrowLeft />
							Go back
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style lang="scss">
	.wrapper {
		background: #fe9908;
	}

	.about-container {
		transform: translateY(24px);
		transition: all 800ms cubic-bezier(0.79, 0.3, 0, 0.96);

		&.reveal {
			opacity: 1;
			transform: translateY(0);
			transition: all 500ms ease-in-out;
		}
	}
</style>

<script>
	import { navigate } from 'astro:transitions/client';

	const graphicsEl = document.getElementById('banner-graphic');
	const aboutContainer = document.getElementById('about-container');
	const linkBack = document.getElementById('link-back');

	function animateGraphic() {
		if (graphicsEl && aboutContainer) {
			graphicsEl.classList.remove('reveal');
			aboutContainer.classList.remove('reveal');

			graphicsEl.classList.add('reveal');
			console.log(aboutContainer);

			setTimeout(() => {
				aboutContainer.classList.add('reveal');
			}, 700);
		}
	}

	animateGraphic();

	linkBack?.addEventListener('click', (e) => {
		e.preventDefault();

		graphicsEl?.classList.remove('reveal');
		aboutContainer?.classList.remove('reveal');

		setTimeout(() => {
			navigate('/');
		}, 1200);
	});
</script>
