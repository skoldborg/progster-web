---
import { MdKeyboardDoubleArrowLeft } from 'react-icons/md';

import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
	{
		title: 'GöteborgsOperan',
		role: 'Lead Front End',
		tech: [
			'React',
			'Typescript',
			'Node.js',
			'GraphQL',
			'Storybook',
			'WCAG',
			'Azure DevOps',
			'Framer Motion',
		],
		url: 'https://www.opera.se',
	},
	{
		title: 'Folkhälsomyndigheten.se',
		role: 'Lead Front End',
		tech: ['React', 'Typescript', 'Storybook', 'WCAG', 'Vitest'],
		url: 'https://capio.se',
	},
	{
		title: 'SDG Impact Assessment Tool',
		role: 'Lead Developer',
		tech: [
			'Next.js',
			'Typescript',
			'Tailwind',
			'Prismic',
			'MongoDB',
			'GraphQL',
			'Auth0',
			'Vitest',
		],
		url: 'https://sdgimpactassessmenttool.org',
	},
	{
		title: 'Capio.se',
		role: 'Lead Front End',
		tech: ['React', 'Typescript', 'React Query', 'Storybook', 'WCAG'],
		url: 'https://capio.se',
	},
];
---

<Layout subtitle="Selected works">
	<section class="wrapper h-full w-full">
		<div class="flex flex-col md:h-full">
			<div class="mx-6 md:mx-10 mt-20 md:mt-40 max-w-6xl">
				<h1 class="font-bold text-3xl md:text-5xl uppercase mb-10 md:mb-20">
					Selected works
				</h1>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					{
						projects.map((p, i) => (
							<ProjectCard
								{...p}
								style={{
									animationDelay: `${i * 0.15}s`,
								}}
							/>
						))
					}
				</div>
				<a href="/" class="flex underline items-center gap-2 md:text-lg mt-8">
					<MdKeyboardDoubleArrowLeft />
					Go back
				</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.wrapper {
		background: linear-gradient(
			to bottom right,
			#fe9908 50%,
			#e55f17 50%,
			#e55f17 80%,
			#fe9908 80%
		);
	}
</style>
