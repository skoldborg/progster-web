---
import { MdKeyboardDoubleArrowLeft } from 'react-icons/md';

import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BannerGraphic from '../components/BannerGraphic.astro';

const projects = [
	{
		title: 'GöteborgsOperan',
		role: 'Lead Front End',
		tech: [
			'React',
			'Typescript',
			'Node.js',
			'GraphQL',
			'Storybook',
			'WCAG',
			'Azure DevOps',
			'Framer Motion',
		],
		url: 'https://www.opera.se',
	},
	{
		title: 'Folkhälsomyndigheten.se',
		role: 'Lead Front End',
		tech: ['React', 'Typescript', 'Storybook', 'WCAG', 'Vitest'],
		url: 'https://capio.se',
	},
	{
		title: 'SDG Impact Assessment Tool',
		role: 'Full Stack Developer',
		tech: [
			'Next.js',
			'Typescript',
			'Tailwind',
			'Prismic',
			'MongoDB',
			'GraphQL',
			'Auth0',
			'Vitest',
		],
		url: 'https://sdgimpactassessmenttool.org',
	},
	{
		title: 'Capio.se',
		role: 'Lead Front End',
		tech: ['React', 'Typescript', 'React Query', 'Storybook', 'WCAG'],
		url: 'https://capio.se',
	},
];
---

<Layout subtitle="Selected works">
	<section class="wrapper relative w-full md:h-full md:overflow-hidden">
		<BannerGraphic />
		<div class="banner"></div>
		<div class="relative flex flex-col md:h-full z-10">
			<div class="mx-6 md:mx-10 mt-20 md:mt-40 max-w-6xl">
				<div id="projects-container" class="projects-container">
					<h1 class="font-bold text-3xl md:text-5xl uppercase mb-10 md:mb-20">
						Selected works
					</h1>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						{
							projects.map((p, i) => (
								<ProjectCard
									{...p}
									style={{
										animationDelay: `${i * 0.15}s`,
									}}
								/>
							))
						}
					</div>
				</div>
				<a
					id="link-back"
					href="/"
					class="flex underline items-center gap-2 md:text-lg mt-8"
				>
					<MdKeyboardDoubleArrowLeft />
					Go back
				</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.wrapper {
		background: #fe9908;
	}

	.projects-container.hide {
		transition: all 800ms cubic-bezier(0.79, 0.3, 0, 0.96);
		opacity: 0;
		transform: translateY(24px);
	}
</style>

<script>
	import { navigate } from 'astro:transitions/client';

	const graphicsEl = document.getElementById('banner-graphic');
	const projectsContainer = document.getElementById('projects-container');
	const linkBack = document.getElementById('link-back');

	function animateGraphic() {
		if (graphicsEl) {
			graphicsEl.classList.remove('reveal');

			graphicsEl.classList.add('reveal');
		}
	}

	animateGraphic();

	linkBack?.addEventListener('click', (e) => {
		e.preventDefault();

		graphicsEl?.classList.remove('reveal');
		projectsContainer?.classList.add('hide');

		setTimeout(() => {
			navigate('/');
		}, 800);
	});
</script>
